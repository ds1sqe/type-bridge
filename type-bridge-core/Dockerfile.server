# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e

# Release builds override only the identity arguments below. Both base images
# and the Rust toolchain are immutable inputs to each server release image.
ARG RUST_BUILDER_IMAGE=rust:1.94.1-bookworm@sha256:6ae102bdbf528294bc79ad6e1fae682f6f7c2a6e6621506ba959f9685b308a55
ARG RUNTIME_IMAGE=debian:bookworm-slim@sha256:7b140f374b289a7c2befc338f42ebe6441b7ea838a042bbd5acbfca6ec875818

FROM ${RUST_BUILDER_IMAGE} AS runtime-security

# The base image predates Debian's PCRE2 security update. Keep each package
# immutable until the next reviewed base-image refresh incorporates it.
ADD --checksum=sha256:81c5502941118a24d47af69a17b8b0b9548d75cc6d72b3eb3fe01047b46fa10e \
    https://security.debian.org/debian-security/pool/updates/main/p/pcre2/libpcre2-8-0_10.42-1+deb12u1_amd64.deb /security/libpcre2-amd64.deb
ADD --checksum=sha256:d178d33697eef877c2c27733141b7f8520fee66a329ae5809e8c8eae3709efa3 \
    https://security.debian.org/debian-security/pool/updates/main/p/pcre2/libpcre2-8-0_10.42-1+deb12u1_arm64.deb /security/libpcre2-arm64.deb

FROM ${RUST_BUILDER_IMAGE} AS builder

WORKDIR /build

# Cargo needs every workspace manifest to resolve the locked graph. The
# .dockerignore allowlist keeps target trees and repository-local material out
# of the build context.
COPY Cargo.toml Cargo.lock LICENSE ./
COPY crates crates
COPY vendor vendor

RUN cargo build --locked --release -p type-bridge-server --no-default-features \
    --features band8,band9,v2-query \
    && strip target/release/type-bridge-server

FROM ${RUNTIME_IMAGE} AS runtime

ARG TARGETARCH
ARG SOURCE_REVISION=unknown
ARG RELEASE_VERSION=0.0.0-dev
ARG CREATED=1970-01-01T00:00:00Z
ARG RELEASE_IDENTITY=unreleased

LABEL org.opencontainers.image.title="TypeBridge Server" \
      org.opencontainers.image.description="TypeBridge TypeDB query proxy with the V1 compatibility and V2 prepared-query surfaces" \
      org.opencontainers.image.url="https://ds1sqe.github.io/type-bridge/" \
      org.opencontainers.image.source="https://github.com/ds1sqe/type-bridge" \
      org.opencontainers.image.documentation="https://ds1sqe.github.io/type-bridge/guide/server-container/" \
      org.opencontainers.image.revision="${SOURCE_REVISION}" \
      org.opencontainers.image.version="${RELEASE_VERSION}" \
      org.opencontainers.image.created="${CREATED}" \
      org.opencontainers.image.licenses="MIT" \
      io.type-bridge.release-identity="${RELEASE_IDENTITY}"

COPY --from=runtime-security /security/libpcre2-${TARGETARCH}.deb /tmp/libpcre2.deb

# Remove package-install logs and inode-dependent loader caches. Normalize
# the password-aging value, which SOURCE_DATE_EPOCH cannot rewrite.
RUN dpkg --install /tmp/libpcre2.deb \
    && rm -f /tmp/libpcre2.deb /var/log/dpkg.log /var/cache/ldconfig/aux-cache \
    && groupadd --gid 10001 typebridge \
    && useradd --uid 10001 --gid 10001 --no-create-home \
      --home-dir /nonexistent --shell /usr/sbin/nologin typebridge \
    && chage --lastday 0 typebridge \
    && rm -f /etc/shadow- \
    && install -d -m 0755 /etc/type-bridge /usr/share/licenses/type-bridge

COPY --from=builder \
    /build/target/release/type-bridge-server /usr/local/bin/type-bridge-server
COPY --from=builder \
    /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY server.container.toml /etc/type-bridge/server.toml
COPY LICENSE /usr/share/licenses/type-bridge/LICENSE
RUN chmod 0555 /usr/local/bin/type-bridge-server \
    && chmod 0444 /etc/ssl/certs/ca-certificates.crt \
      /etc/type-bridge/server.toml /usr/share/licenses/type-bridge/LICENSE

USER 10001:10001
WORKDIR /
EXPOSE 8080
STOPSIGNAL SIGTERM

ENTRYPOINT ["/usr/local/bin/type-bridge-server"]
CMD ["--config", "/etc/type-bridge/server.toml"]
