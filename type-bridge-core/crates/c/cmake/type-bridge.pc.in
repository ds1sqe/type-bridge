prefix=${pcfiledir}/@TYPE_BRIDGE_PC_PREFIX_FROM_PCDIR@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@
# Package metadata and native ABI share version 2.0.0.
# The native ABI is abi_version, provided as the type-bridge-abi module.
abi_version=@TYPE_BRIDGE_C_ABI_VERSION@

Name: TypeBridge C
Description: Rust-owned TypeBridge C ABI 2.0 (query product version at runtime)
Version: @PROJECT_VERSION@
Provides: type-bridge-abi = @TYPE_BRIDGE_C_ABI_VERSION@
Libs: -L${libdir} -ltype_bridge_c
Cflags: -I${includedir}
