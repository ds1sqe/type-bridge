# TypeBridge ordered-collection generator resource v3
cmake_minimum_required(VERSION 3.20)
project(@TYPE_BRIDGE_C_SYMBOL_PREFIX@_schema VERSION 1.0.0 LANGUAGES C)

include(CMakePackageConfigHelpers)
include(GNUInstallDirs)

string(REPLACE "\\" "/" TYPE_BRIDGE_C_INSTALL_LIBDIR "${CMAKE_INSTALL_LIBDIR}")
string(REPLACE "\\" "/" TYPE_BRIDGE_C_INSTALL_INCLUDEDIR "${CMAKE_INSTALL_INCLUDEDIR}")
if(TYPE_BRIDGE_C_INSTALL_LIBDIR STREQUAL "" OR
   IS_ABSOLUTE "${TYPE_BRIDGE_C_INSTALL_LIBDIR}" OR
   TYPE_BRIDGE_C_INSTALL_LIBDIR MATCHES "(^|/)\\.\\.(/|$)")
  message(FATAL_ERROR
    "CMAKE_INSTALL_LIBDIR must be a non-empty relative path confined to the install prefix")
endif()
if(TYPE_BRIDGE_C_INSTALL_INCLUDEDIR STREQUAL "" OR
   IS_ABSOLUTE "${TYPE_BRIDGE_C_INSTALL_INCLUDEDIR}" OR
   TYPE_BRIDGE_C_INSTALL_INCLUDEDIR MATCHES "(^|/)\\.\\.(/|$)")
  message(FATAL_ERROR
    "CMAKE_INSTALL_INCLUDEDIR must be a non-empty relative path confined to the install prefix")
endif()
set(CMAKE_INSTALL_LIBDIR "${TYPE_BRIDGE_C_INSTALL_LIBDIR}")
set(CMAKE_INSTALL_INCLUDEDIR "${TYPE_BRIDGE_C_INSTALL_INCLUDEDIR}")
file(
  RELATIVE_PATH TYPE_BRIDGE_PC_PREFIX_FROM_PCDIR
  "${CMAKE_INSTALL_PREFIX}/${TYPE_BRIDGE_C_INSTALL_LIBDIR}/pkgconfig"
  "${CMAKE_INSTALL_PREFIX}"
)

find_package(TypeBridge 1.5 CONFIG REQUIRED)

add_library(@TYPE_BRIDGE_C_SYMBOL_PREFIX@_schema STATIC src/models.c)
add_library(@TYPE_BRIDGE_C_SYMBOL_PREFIX@::schema ALIAS @TYPE_BRIDGE_C_SYMBOL_PREFIX@_schema)
set_target_properties(
  @TYPE_BRIDGE_C_SYMBOL_PREFIX@_schema
  PROPERTIES EXPORT_NAME schema POSITION_INDEPENDENT_CODE ON
)
target_compile_features(@TYPE_BRIDGE_C_SYMBOL_PREFIX@_schema PUBLIC c_std_17)
target_include_directories(
  @TYPE_BRIDGE_C_SYMBOL_PREFIX@_schema
  PUBLIC
    $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/include>
    $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}>
)
target_link_libraries(@TYPE_BRIDGE_C_SYMBOL_PREFIX@_schema PUBLIC TypeBridge::C)

configure_file(
  @TYPE_BRIDGE_C_SYMBOL_PREFIX@.pc.in
  ${CMAKE_CURRENT_BINARY_DIR}/@TYPE_BRIDGE_C_SYMBOL_PREFIX@.pc
  @ONLY
)
configure_package_config_file(
  @TYPE_BRIDGE_C_SYMBOL_PREFIX@Config.cmake.in
  ${CMAKE_CURRENT_BINARY_DIR}/@TYPE_BRIDGE_C_SYMBOL_PREFIX@Config.cmake
  INSTALL_DESTINATION ${CMAKE_INSTALL_LIBDIR}/cmake/@TYPE_BRIDGE_C_SYMBOL_PREFIX@
)
write_basic_package_version_file(
  ${CMAKE_CURRENT_BINARY_DIR}/@TYPE_BRIDGE_C_SYMBOL_PREFIX@ConfigVersion.cmake
  VERSION ${PROJECT_VERSION}
  COMPATIBILITY SameMajorVersion
)

install(
  TARGETS @TYPE_BRIDGE_C_SYMBOL_PREFIX@_schema
  EXPORT @TYPE_BRIDGE_C_SYMBOL_PREFIX@Targets
  ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR}
  LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR}
  RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR}
  INCLUDES DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}
)
install(DIRECTORY include/ DESTINATION ${CMAKE_INSTALL_INCLUDEDIR})
install(
  EXPORT @TYPE_BRIDGE_C_SYMBOL_PREFIX@Targets
  FILE @TYPE_BRIDGE_C_SYMBOL_PREFIX@Targets.cmake
  NAMESPACE @TYPE_BRIDGE_C_SYMBOL_PREFIX@::
  DESTINATION ${CMAKE_INSTALL_LIBDIR}/cmake/@TYPE_BRIDGE_C_SYMBOL_PREFIX@
)
install(
  FILES
    ${CMAKE_CURRENT_BINARY_DIR}/@TYPE_BRIDGE_C_SYMBOL_PREFIX@Config.cmake
    ${CMAKE_CURRENT_BINARY_DIR}/@TYPE_BRIDGE_C_SYMBOL_PREFIX@ConfigVersion.cmake
  DESTINATION ${CMAKE_INSTALL_LIBDIR}/cmake/@TYPE_BRIDGE_C_SYMBOL_PREFIX@
)
install(
  FILES ${CMAKE_CURRENT_BINARY_DIR}/@TYPE_BRIDGE_C_SYMBOL_PREFIX@.pc
  DESTINATION ${CMAKE_INSTALL_LIBDIR}/pkgconfig
)
