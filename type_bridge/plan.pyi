from collections.abc import Iterable, Mapping, Sequence
from dataclasses import dataclass
from datetime import date, datetime, timedelta
from decimal import Decimal
from typing import Any, Literal, Never, NotRequired, Protocol, Self, TypedDict, overload

from type_bridge_core import (
    Count as Count,
)
from type_bridge_core import (
    Documents as Documents,
)
from type_bridge_core import (
    Exists as Exists,
)
from type_bridge_core import (
    Iid,
    PlanAuthority,
    QueryLimits,
    _Plan,
)
from type_bridge_core import (
    Matched as Matched,
)
from type_bridge_core import (
    Pending as Pending,
)
from type_bridge_core import (
    PlanAnswer as PlanAnswer,
)
from type_bridge_core import (
    PlanError as _PlanError,
)
from type_bridge_core import (
    Rows as Rows,
)
from type_bridge_core import (
    StagedPlan as StagedPlan,
)
from type_bridge_core import (
    Transaction as Transaction,
)

PlanError = _PlanError

type PlanValueType = Literal[
    "string", "long", "double", "boolean", "date", "datetime", "datetime_tz", "decimal", "duration"
]
type _Scalar = bool | int | float | str | Decimal | date | timedelta | PlanLiteral[Any]
type _Operand = PlanValue | PlanInput[Any] | PlanThing | _Scalar
type _ExprLike = PlanExpr | _Operand
type _Answer = Rows | Documents | Count | Exists | Matched

class _FieldToken(Protocol):
    @property
    def owner(self) -> type[Any]: ...
    @property
    def fact(self) -> Mapping[str, object]: ...

class _RoleToken(Protocol):
    @property
    def owner(self) -> type[Any]: ...
    @property
    def fact(self) -> Mapping[str, object]: ...

class PlanLiteral[T]:
    value_type: PlanValueType
    value: object
    def __init__(self, value_type: PlanValueType, value: object) -> None: ...

@overload
def literal(value_type: Literal["string"], value: object) -> PlanLiteral[str]: ...
@overload
def literal(value_type: Literal["long"], value: object) -> PlanLiteral[int]: ...
@overload
def literal(value_type: Literal["double"], value: object) -> PlanLiteral[float]: ...
@overload
def literal(value_type: Literal["boolean"], value: object) -> PlanLiteral[bool]: ...
@overload
def literal(value_type: Literal["date"], value: object) -> PlanLiteral[date]: ...
@overload
def literal(value_type: Literal["datetime"], value: object) -> PlanLiteral[datetime]: ...
@overload
def literal(value_type: Literal["datetime_tz"], value: object) -> PlanLiteral[datetime]: ...
@overload
def literal(value_type: Literal["decimal"], value: object) -> PlanLiteral[Decimal]: ...
@overload
def literal(value_type: Literal["duration"], value: object) -> PlanLiteral[timedelta]: ...
@overload
def literal(value_type: PlanValueType, value: object) -> PlanLiteral[Any]: ...

class _Comparable:
    def eq(self, other: _Operand) -> PlanCondition: ...
    def ne(self, other: _Operand) -> PlanCondition: ...
    def lt(self, other: _Operand) -> PlanCondition: ...
    def le(self, other: _Operand) -> PlanCondition: ...
    def gt(self, other: _Operand) -> PlanCondition: ...
    def ge(self, other: _Operand) -> PlanCondition: ...
    def __add__(self, other: _ExprLike) -> PlanExpr: ...
    def __sub__(self, other: _ExprLike) -> PlanExpr: ...
    def __mul__(self, other: _ExprLike) -> PlanExpr: ...
    def __truediv__(self, other: _ExprLike) -> PlanExpr: ...
    def __mod__(self, other: _ExprLike) -> PlanExpr: ...

class PlanThing:
    model: type[Any]

class PlanValue(_Comparable): ...

class PlanInput[T](_Comparable):
    value_type: PlanValueType
    def value(self, value: T) -> PlanInputCell[T]: ...
    def absent(self) -> PlanInputCell[T]: ...

class PlanInputCell[T]:
    input: PlanInput[T]
    value: T | None
    def __init__(self, input: PlanInput[T], value: T | None) -> None: ...

@dataclass(frozen=True)
class StagedResultRef:
    input: PlanInput[Any]
    source_plan: int
    source_column: int
    expected_types: Sequence[type[Any]]

class PlanCondition:
    comparator: str
    left: object
    right: object
    def __init__(self, left: object, comparator: str, right: object) -> None: ...
    def __bool__(self) -> Never: ...

class PlanExpr:
    def __add__(self, other: _ExprLike) -> PlanExpr: ...
    def __sub__(self, other: _ExprLike) -> PlanExpr: ...
    def __mul__(self, other: _ExprLike) -> PlanExpr: ...
    def __truediv__(self, other: _ExprLike) -> PlanExpr: ...
    def __mod__(self, other: _ExprLike) -> PlanExpr: ...
    @staticmethod
    def pow(base: _ExprLike, exponent: _ExprLike) -> PlanExpr: ...
    @staticmethod
    def abs(value: _ExprLike) -> PlanExpr: ...
    @staticmethod
    def ceil(value: _ExprLike) -> PlanExpr: ...
    @staticmethod
    def floor(value: _ExprLike) -> PlanExpr: ...
    @staticmethod
    def round(value: _ExprLike) -> PlanExpr: ...
    @staticmethod
    def min(left: _ExprLike, right: _ExprLike) -> PlanExpr: ...
    @staticmethod
    def max(left: _ExprLike, right: _ExprLike) -> PlanExpr: ...
    @staticmethod
    def length(value: _ExprLike) -> PlanExpr: ...

class PlanNewThing:
    def field(self, token: _FieldToken, value: _Operand) -> Self: ...
    def player(self, token: _RoleToken, player: PlanThing) -> Self: ...
    def thing(self) -> PlanThing: ...

class _Inputs:
    @overload
    def input(self, name: str, value_type: Literal["string"]) -> PlanInput[str]: ...
    @overload
    def input(self, name: str, value_type: Literal["long"]) -> PlanInput[int]: ...
    @overload
    def input(self, name: str, value_type: Literal["double"]) -> PlanInput[float]: ...
    @overload
    def input(self, name: str, value_type: Literal["boolean"]) -> PlanInput[bool]: ...
    @overload
    def input(self, name: str, value_type: Literal["date"]) -> PlanInput[date]: ...
    @overload
    def input(self, name: str, value_type: Literal["datetime"]) -> PlanInput[datetime]: ...
    @overload
    def input(self, name: str, value_type: Literal["datetime_tz"]) -> PlanInput[datetime]: ...
    @overload
    def input(self, name: str, value_type: Literal["decimal"]) -> PlanInput[Decimal]: ...
    @overload
    def input(self, name: str, value_type: Literal["duration"]) -> PlanInput[timedelta]: ...
    @overload
    def input(self, name: str, value_type: PlanValueType) -> PlanInput[Any]: ...
    @overload
    def optional_input(self, name: str, value_type: Literal["string"]) -> PlanInput[str]: ...
    @overload
    def optional_input(self, name: str, value_type: Literal["long"]) -> PlanInput[int]: ...
    @overload
    def optional_input(self, name: str, value_type: Literal["double"]) -> PlanInput[float]: ...
    @overload
    def optional_input(self, name: str, value_type: Literal["boolean"]) -> PlanInput[bool]: ...
    @overload
    def optional_input(self, name: str, value_type: Literal["date"]) -> PlanInput[date]: ...
    @overload
    def optional_input(self, name: str, value_type: Literal["datetime"]) -> PlanInput[datetime]: ...
    @overload
    def optional_input(
        self, name: str, value_type: Literal["datetime_tz"]
    ) -> PlanInput[datetime]: ...
    @overload
    def optional_input(self, name: str, value_type: Literal["decimal"]) -> PlanInput[Decimal]: ...
    @overload
    def optional_input(
        self, name: str, value_type: Literal["duration"]
    ) -> PlanInput[timedelta]: ...
    @overload
    def optional_input(self, name: str, value_type: PlanValueType) -> PlanInput[Any]: ...
    def row(self, cells: Iterable[PlanInputCell[Any]]) -> Self: ...

class PlanBuilder(_Inputs):
    def __init__(self, *, query_limits: QueryLimits | None = None) -> None: ...
    def exact(self, model: type[Any]) -> PlanThing: ...
    def subtypes(self, model: type[Any]) -> PlanThing: ...
    def by_iid_input(self, thing: PlanThing, column: PlanInput[str]) -> Self: ...
    def field(self, thing: PlanThing, token: _FieldToken) -> PlanValue: ...
    def where_(self, condition: PlanCondition) -> Self: ...
    def links(self, relation: PlanThing, role: _RoleToken, player: PlanThing) -> Self: ...
    def let_(self, name: str, expr: _ExprLike) -> PlanValue: ...
    def update(self, owner: PlanThing, field: _FieldToken, value: _Operand) -> Self: ...
    def update_player(self, relation: PlanThing, role: _RoleToken, player: PlanThing) -> Self: ...
    def insert(self, model: type[Any]) -> PlanNewThing: ...
    def put(self, model: type[Any]) -> PlanNewThing: ...
    def delete(self, thing: PlanThing) -> Self: ...
    def delete_field(self, owner: PlanThing, field: _FieldToken) -> Self: ...
    def delete_player(self, relation: PlanThing, role: _RoleToken, player: PlanThing) -> Self: ...
    def returning(self, columns: Iterable[PlanThing | PlanValue]) -> Self: ...
    def fetch(
        self, thing: PlanThing, roles: Iterable[_RoleToken | tuple[_RoleToken, bool]] = ()
    ) -> Self: ...
    def count(self) -> Self: ...
    def exists(self) -> Self: ...
    def build(self, authority: PlanAuthority) -> Plan[_Answer]: ...
    def build_staged(
        self,
        authority: PlanAuthority,
        rows: Iterable[Iterable[PlanInputCell[Any]]],
        result_refs: Iterable[StagedResultRef] = (),
    ) -> StagedPlan: ...

type Condition = PlanCondition
type _ValueLike[T] = T | Value[T] | Expr[T] | PlanInput[T] | PlanLiteral[T]

class _Comparisons[T]:
    def contains(self: _Comparisons[str], other: _ValueLike[str]) -> Condition: ...
    def starts_with(self: _Comparisons[str], other: _ValueLike[str]) -> Condition: ...
    def ends_with(self: _Comparisons[str], other: _ValueLike[str]) -> Condition: ...
    def like(self: _Comparisons[str], other: _ValueLike[str]) -> Condition: ...
    def eq(self, other: _ValueLike[T]) -> Condition: ...
    def ne(self, other: _ValueLike[T]) -> Condition: ...
    def lt(self, other: _ValueLike[T]) -> Condition: ...
    def le(self, other: _ValueLike[T]) -> Condition: ...
    def gt(self, other: _ValueLike[T]) -> Condition: ...
    def ge(self, other: _ValueLike[T]) -> Condition: ...
    def __eq__(self, other: _ValueLike[T]) -> Condition: ...  # pyright: ignore[reportIncompatibleMethodOverride]
    def __ne__(self, other: _ValueLike[T]) -> Condition: ...  # pyright: ignore[reportIncompatibleMethodOverride]
    def __lt__(self, other: _ValueLike[T]) -> Condition: ...
    def __le__(self, other: _ValueLike[T]) -> Condition: ...
    def __gt__(self, other: _ValueLike[T]) -> Condition: ...
    def __ge__(self, other: _ValueLike[T]) -> Condition: ...

class _Arithmetic[T](_Comparisons[T]):
    @overload
    def __add__(self: _Arithmetic[int], other: _ValueLike[int]) -> Expr[int]: ...
    @overload
    def __add__(self: _Arithmetic[float], other: _ValueLike[float]) -> Expr[float]: ...
    @overload
    def __add__(self: _Arithmetic[Decimal], other: _ValueLike[Decimal]) -> Expr[Decimal]: ...
    @overload
    def __sub__(self: _Arithmetic[int], other: _ValueLike[int]) -> Expr[int]: ...
    @overload
    def __sub__(self: _Arithmetic[float], other: _ValueLike[float]) -> Expr[float]: ...
    @overload
    def __sub__(self: _Arithmetic[Decimal], other: _ValueLike[Decimal]) -> Expr[Decimal]: ...
    @overload
    def __mul__(self: _Arithmetic[int], other: _ValueLike[int]) -> Expr[int]: ...
    @overload
    def __mul__(self: _Arithmetic[float], other: _ValueLike[float]) -> Expr[float]: ...
    @overload
    def __mul__(self: _Arithmetic[Decimal], other: _ValueLike[Decimal]) -> Expr[Decimal]: ...
    @overload
    def __mod__(self: _Arithmetic[int], other: _ValueLike[int]) -> Expr[int]: ...
    @overload
    def __mod__(self: _Arithmetic[float], other: _ValueLike[float]) -> Expr[float]: ...
    @overload
    def __mod__(self: _Arithmetic[Decimal], other: _ValueLike[Decimal]) -> Expr[float]: ...
    @overload
    def __truediv__(self: _Arithmetic[int], other: _ValueLike[int]) -> Expr[float]: ...
    @overload
    def __truediv__(self: _Arithmetic[float], other: _ValueLike[float]) -> Expr[float]: ...
    @overload
    def __truediv__(self: _Arithmetic[Decimal], other: _ValueLike[Decimal]) -> Expr[float]: ...

class Value[T](_Arithmetic[T]):
    def __new__(cls) -> Never: ...

class Expr[T](_Arithmetic[T]):
    def __new__(cls) -> Never: ...

class FieldToken[T](_Comparisons[T]): ...

class Handle[M]:
    def __new__(cls) -> Never: ...
    def where(self, *conditions: Condition) -> Self: ...
    def unset(self, field: FieldToken[Any]) -> Plan[list[M]]: ...
    def delete(self) -> Plan[Matched]: ...
    def delete_returning(self) -> Plan[list[M]]: ...
    def _value[T](self, field: FieldToken[T]) -> Value[T]: ...
    def _set(self, fields: Mapping[str, Any]) -> Plan[list[M]]: ...
    def _link(self, players: Mapping[str, Any], *, remove: bool) -> Plan[list[M]]: ...

class ExplainedType(TypedDict):
    """One possible schema type."""

    kind: Literal["entity", "relation", "attribute"]
    label: str

class ExplainedBinding(TypedDict):
    """Binding identity, provider variable, and possible schema types."""

    id: int
    variable: str
    possible_types: list[ExplainedType]

class ExplainedInput(TypedDict):
    """Input declaration without its transported values."""

    public_name: str
    value_type: PlanValueType
    optional: bool

class ExplainedFingerprint(TypedDict):
    """Canonical plan-shape fingerprint, excluding transported caller values."""

    algorithm: str
    canonicalization: str
    digest: str
    domain: str

class ExplainedOperation(TypedDict):
    """Terminal kind and optional write result kind."""

    kind: Literal["rows", "count", "exists", "write"]
    returns: NotRequired[Literal["rows", "matched"]]

class ExplainedGiven(TypedDict):
    """Transport size without the input values."""

    row_count: int
    canonical_bytes: int

@dataclass(frozen=True)
class PlanExplanation:
    """Exact provider program. Given values are omitted; plan constants remain."""

    fingerprint: ExplainedFingerprint
    format: str
    required_capabilities: list[str]
    operation: ExplainedOperation
    bindings: list[ExplainedBinding]
    inputs: list[ExplainedInput]
    given: ExplainedGiven
    statements: list[str]
    read_statements: int
    write_statements: int

class Plan[R](_Plan[R]):
    def explain(self) -> PlanExplanation: ...
    def __new__(
        cls, plan: _Plan[R] | None = None, *, query_limits: QueryLimits | None = None
    ) -> Self: ...
    def __init__(
        self, plan: _Plan[R] | None = None, *, query_limits: QueryLimits | None = None
    ) -> None: ...
    def __enter__(self) -> Plan[Matched]: ...
    def __exit__(self, *exc: object) -> None: ...
    def require(self, *conditions: Condition) -> None: ...
    def count(self) -> Plan[int]: ...
    @overload
    def returning[A](self, a: Value[A] | Handle[A], /) -> Plan[list[tuple[A]]]: ...
    @overload
    def returning[A, B](
        self, a: Value[A] | Handle[A], b: Value[B] | Handle[B], /
    ) -> Plan[list[tuple[A, B]]]: ...
    @overload
    def returning[A, B, C](
        self, a: Value[A] | Handle[A], b: Value[B] | Handle[B], c: Value[C] | Handle[C], /
    ) -> Plan[list[tuple[A, B, C]]]: ...
    @overload
    def returning(self, *values: Value[Any] | Handle[Any]) -> Plan[list[tuple[Any, ...]]]: ...
    def exists(self) -> Plan[bool]: ...
    def bind(self, rows: Iterable[Iterable[PlanInputCell[Any]]]) -> Plan[R]: ...
    @staticmethod
    def builder() -> PlanBuilder: ...
    @staticmethod
    def template(*, query_limits: QueryLimits | None = None) -> PlanTemplate: ...

class PlanTemplate(Plan[Matched], _Inputs):
    def __init__(self, *, query_limits: QueryLimits | None = None) -> None: ...
    def __enter__(self) -> Self: ...

_MISSING: Any

def _match[H: Handle[Any]](
    model: type[Any],
    handle: type[H],
    authority: PlanAuthority,
    key_field: str | None,
    key: object,
    fields: Mapping[str, object],
    *,
    subtypes: bool = False,
    iid: Iid | None = None,
) -> H: ...
def _insert[M](
    model: type[M],
    authority: PlanAuthority,
    fields: Mapping[str, object],
    players: Mapping[str, object],
    *,
    put: bool = False,
) -> Plan[list[M]]: ...
def _bulk_insert[M](
    model: type[M],
    authority: PlanAuthority,
    rows: Iterable[Mapping[str, object]],
    *,
    put: bool = False,
) -> Plan[list[M]]: ...
