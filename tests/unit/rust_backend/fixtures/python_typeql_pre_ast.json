      "equivalent": true
    },
    {
      "case": "double",
      "old": "match $e isa key-holder-double, has key-double 1.5;",
      "new_existing_typed_path": "match $e isa key-holder-double, has key-double 1.5;",
      "equivalent": true
    },
    {
      "case": "boolean",
      "old": "match $e isa key-holder-boolean, has key-boolean true;",
      "new_existing_typed_path": "match $e isa key-holder-boolean, has key-boolean true;",
      "equivalent": true
    },
    {
      "case": "date",
      "old": "match $e isa key-holder-date, has key-date 2026-10-16;",
      "new_existing_typed_path": "match $e isa key-holder-date, has key-date 2026-10-16;",
      "equivalent": true
    },
    {
      "case": "datetime",
      "old": "match $e isa key-holder-datetime, has key-datetime 2026-10-16T10:11:12;",
      "new_existing_typed_path": "match $e isa key-holder-datetime, has key-datetime 2026-10-16T10:11:12;",
      "equivalent": true
    },
    {
      "case": "datetime-tz",
      "old": "match $e isa key-holder-datetime-tz, has key-datetime-tz 2026-10-16T10:11:12-04:00;",
      "new_existing_typed_path": "match $e isa key-holder-datetime-tz, has key-datetime-tz 2026-10-16T10:11:12-04:00;",
      "equivalent": true
    },
    {
      "case": "decimal",
      "old": "match $e isa key-holder-decimal, has key-decimal 1.25dec;",
      "new_existing_typed_path": "match $e isa key-holder-decimal, has key-decimal 1.25dec;",
      "equivalent": true
    },
    {
      "case": "duration",
      "old": "match $e isa key-holder-duration, has key-duration P1D;",
      "new_existing_typed_path": "match $e isa key-holder-duration, has key-duration P1D;",
      "equivalent": true
    }
  ],
  "schemas": [
    {
      "case": "attribute_doc_meta",
      "schema": "attribute legacy-name @doc(\"name \\\"doc\\\"\") @meta(\"a\", \"first\") @meta(\"z\", \"last\"), value string;"
    },
    {
      "case": "attribute_range",
      "schema": "attribute legacy-age, value integer @range(0..150);"
    },
    {
      "case": "entity_parent",
      "schema": "entity legacy-parent @abstract @doc(\"parent\") @meta(\"owner\", \"schema\"),\n    owns legacy-name @key;"
    },
    {
      "case": "entity_child",
      "schema": "entity legacy-child, sub legacy-parent,\n    owns legacy-age @card(0..1);"
    },
    {
      "case": "relation_base",
      "schema": "relation legacy-base @abstract,\n    relates participant[] @abstract;"
    },
    {
      "case": "relation_child_ordered",
      "schema": "relation legacy-review @abstract, sub legacy-base,\n    relates reviewer[] as participant[] @abstract @doc(\"reviewer\"),\n    owns legacy-name[] @doc(\"names\") @meta(\"owner\", \"bridge\");"
    }
  ],
  "functions": [
    {
      "case": "ids",
      "types": [
        "id"
      ],
      "is_stream": true,
      "args": [],
      "options": {
        "limit": 3,
        "offset": 2,
        "sort_var": "id"
      },
      "query": "match let $id in ids();\nsort $id asc;\noffset 2;\nlimit 3;\nfetch { \"id\": $id};"
    },
    {
      "case": "pair",
      "types": [
        "integer",
        "integer"
      ],
      "is_stream": false,
      "args": [],
      "options": {
        "result_vars": [
          "left",
          "right"
        ],
        "fetch_keys": [
          "a",
          "b"
        ],
        "sort_var": "right",
        "sort_order": "desc",
        "limit": 2
      },
      "query": "match let $left, $right = pair();\nsort $right desc;\nlimit 2;\nfetch { \"a\": $left, \"b\": $right};"
    },
    {
      "case": "answer",
      "types": [
        "integer"
      ],
      "is_stream": false,
      "args": [],
      "options": {},
      "query": "match let $integer = answer();\nfetch { \"integer\": $integer};"
    },
    {
      "case": "echo",
      "types": [
        "integer"
      ],
      "is_stream": false,
      "args": [
        [
          "seed",
          7
        ]
      ],
      "options": {},
      "query": "match let $integer = echo(7);\nfetch { \"integer\": $integer};"
    }
  ]
}
