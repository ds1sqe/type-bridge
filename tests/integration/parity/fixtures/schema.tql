define
attribute parity-id, value string;
attribute parity-name, value string;
attribute parity-email, value string;
attribute parity-age, value integer;
attribute parity-score, value double;
attribute parity-active, value boolean;
attribute parity-birth-date, value date;
attribute parity-login-at, value datetime;
attribute parity-seen-at, value datetime-tz;
attribute parity-balance, value decimal;
attribute parity-session-length, value duration;
attribute parity-tag, value string;
attribute parity-note, value string;
attribute parity-since, value date;
attribute parity-confidence, value integer;
attribute parity-kind, value string;

entity parity-party @abstract,
  owns parity-id @key,
  owns parity-name,
  plays parity-token-origin:token;

entity parity-person sub parity-party,
  owns parity-email @unique,
  owns parity-age,
  owns parity-score,
  owns parity-active,
  owns parity-birth-date,
  owns parity-login-at,
  owns parity-seen-at,
  owns parity-balance,
  owns parity-session-length,
  owns parity-tag @card(0..5),
  plays parity-membership:member,
  plays parity-membership:evidence;

entity parity-company,
  owns parity-id @key,
  owns parity-name,
  plays parity-membership:organization,
  plays parity-token-origin:issue;

entity parity-email-message,
  owns parity-id @key,
  owns parity-note,
  plays parity-membership:evidence;

relation parity-membership,
  relates member @card(1..1),
  relates organization @card(1..1),
  relates evidence @card(0..5),
  owns parity-since,
  owns parity-confidence;

relation parity-token-origin,
  relates token @card(1..1),
  relates issue @card(1..1),
  owns parity-kind;
