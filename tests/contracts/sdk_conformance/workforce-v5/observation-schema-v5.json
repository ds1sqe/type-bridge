{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://type-bridge.dev/contracts/sdk-conformance/workforce-observation-v5.schema.json",
  "title": "TypeBridge closed Workforce V5 observation algebra",
  "oneOf": [
    {"$ref": "#/$defs/canonicalRecordArchive"},
    {"$ref": "#/$defs/cancellation"},
    {"$ref": "#/$defs/resourceLimits"},
    {"$ref": "#/$defs/diagnostic"},
    {"$ref": "#/$defs/lifecycle"}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "canonicalRecordArchive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_sha256", "archive_sha256", "round_trip", "foreign_schema_code", "direct_remote_equal", "detached_mutation_code"],
      "properties": {
        "record_sha256": {
          "type": "array", "minItems": 9, "maxItems": 9,
          "items": {"$ref": "#/$defs/sha256"}
        },
        "archive_sha256": {"$ref": "#/$defs/sha256"},
        "round_trip": {"const": true},
        "foreign_schema_code": {"const": "projected_record_schema_mismatch"},
        "direct_remote_equal": {"const": true},
        "detached_mutation_code": {"const": "projected_snapshot_detached"}
      }
    },
    "cancellation": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "partial_output"],
      "properties": {
        "code": {"const": "projected_codec_cancelled"},
        "partial_output": {"const": false}
      }
    },
    "resourceLimits": {
      "type": "object", "additionalProperties": false,
      "required": ["input_code", "output_code", "member_code", "depth_code", "partial_output"],
      "properties": {
        "input_code": {"const": "projected_codec_input_limit"},
        "output_code": {"const": "projected_codec_output_limit"},
        "member_code": {"const": "projected_codec_member_limit"},
        "depth_code": {"const": "projected_codec_depth_limit"},
        "partial_output": {"const": false}
      }
    },
    "diagnostic": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "category", "path", "payload_absent"],
      "properties": {
        "code": {"const": "projected_record_schema_mismatch"},
        "category": {"const": "invalid_input"},
        "path": {"const": ["declared_schema_identity"]},
        "payload_absent": {"const": true}
      }
    },
    "lifecycle": {
      "type": "object", "additionalProperties": false,
      "required": ["bytes_closed", "builder_closed", "archive_closed", "decoded_closed", "repeat_close", "sibling_usable"],
      "properties": {
        "bytes_closed": {"const": true},
        "builder_closed": {"const": true},
        "archive_closed": {"const": true},
        "decoded_closed": {"const": true},
        "repeat_close": {"const": true},
        "sibling_usable": {"const": true}
      }
    }
  }
}
