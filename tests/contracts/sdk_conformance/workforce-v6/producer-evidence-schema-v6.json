{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://typebridge.dev/contracts/sdk-conformance/workforce-v6/producer-evidence-schema-v6.json",
  "title": "TypeBridge Workforce V6 measured producer evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "binding", "producer", "run_nonce", "source_commit", "observations", "non_selected_proofs", "cleanup"],
  "properties": {
    "format": {"const": "typebridge.workforce-v6-producer-evidence/v1"},
    "binding": {"enum": ["python", "node", "rust", "c"]},
    "producer": {"type": "string", "minLength": 1},
    "run_nonce": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "observations": {"type": "array", "minItems": 5, "maxItems": 5},
    "non_selected_proofs": {
      "type": "array",
      "minItems": 25,
      "maxItems": 25,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability_id", "proof_kind", "evidence_b64"],
        "properties": {
          "capability_id": {"type": "string", "minLength": 1},
          "proof_kind": {"type": "string", "minLength": 1},
          "evidence_b64": {"type": "string", "minLength": 4}
        }
      }
    },
    "cleanup": {"type": "object"}
  }
}
