{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://typebridge.dev/contracts/sdk-conformance/workforce-v6/report-schema-v6.json",
  "title": "TypeBridge Workforce V6 candidate report",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "binding", "producer", "source_commit", "manifest", "catalog", "journey", "broad_case_ledger", "phase4_report_sha256", "artifacts", "generated_surface", "predecessor_reports", "non_selected_proofs", "results", "cleanup", "publication_authority"],
  "properties": {
    "format": {"const": "typebridge.sdk-conformance-report/v6"},
    "binding": {"enum": ["python", "node", "rust", "c"]},
    "producer": {"type": "string", "minLength": 1},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "manifest": {"$ref": "#/$defs/identity"},
    "catalog": {"$ref": "#/$defs/identity"},
    "journey": {"$ref": "#/$defs/identity"},
    "broad_case_ledger": {"$ref": "#/$defs/identity"},
    "phase4_report_sha256": {"$ref": "#/$defs/sha256"},
    "artifacts": {"type": "object"},
    "generated_surface": {"type": "object"},
    "predecessor_reports": {"type": "array", "minItems": 4, "maxItems": 5},
    "non_selected_proofs": {"type": "array", "minItems": 25, "maxItems": 25},
    "results": {"type": "array", "minItems": 5, "maxItems": 5},
    "cleanup": {"type": "object"},
    "publication_authority": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}
    }
  }
}
