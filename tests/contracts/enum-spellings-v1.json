{
  "corpus_id": "type-bridge.enum-spellings",
  "version": 1,
  "description": "Every closed enum a binding accepts as text has one parser in the Rust core. An unknown spelling is one diagnostic in every language: category invalid_input, code unknown_enum_value, details kind (the enum kind), accepted (canonical spellings, then aliases), and value (the rejected text, only when it is a bounded identifier). Rust checks the parsers; Python and Node check canonical_enum_spelling / canonicalEnumSpelling and the binding calls that parse each kind.",
  "cases": [
    {
      "id": "comparison_operator.unknown",
      "description": "An operator outside the canonical comparison names.",
      "kind": "comparison_operator",
      "value": "equals",
      "expected": {
        "category": "invalid_input",
        "code": "unknown_enum_value",
        "details": {
          "kind": {
            "kind": "query_identity",
            "value": "comparison_operator"
          },
          "value": {
            "kind": "query_identity",
            "value": "equals"
          },
          "accepted": {
            "kind": "query_identity_list",
            "value": [
              "equal",
              "not_equal",
              "less_than",
              "less_than_or_equal",
              "greater_than",
              "greater_than_or_equal",
              "contains",
              "starts_with",
              "ends_with",
              "regex"
            ]
          }
        }
      }
    },
    {
      "id": "sort_direction.unknown",
      "description": "Abbreviations are not accepted.",
      "kind": "sort_direction",
      "value": "desc",
      "expected": {
        "category": "invalid_input",
        "code": "unknown_enum_value",
        "details": {
          "kind": {
            "kind": "query_identity",
            "value": "sort_direction"
          },
          "value": {
            "kind": "query_identity",
            "value": "desc"
          },
          "accepted": {
            "kind": "query_identity_list",
            "value": [
              "ascending",
              "descending"
            ]
          }
        }
      }
    },
    {
      "id": "missing_order.unknown",
      "description": "A missing-key order outside reject, first, and last.",
      "kind": "missing_order",
      "value": "none",
      "expected": {
        "category": "invalid_input",
        "code": "unknown_enum_value",
        "details": {
          "kind": {
            "kind": "query_identity",
            "value": "missing_order"
          },
          "value": {
            "kind": "query_identity",
            "value": "none"
          },
          "accepted": {
            "kind": "query_identity_list",
            "value": [
              "reject",
              "first",
              "last"
            ]
          }
        }
      }
    },
    {
      "id": "row_cardinality.unknown",
      "description": "A row cardinality outside the core's three.",
      "kind": "row_cardinality",
      "value": "many",
      "expected": {
        "category": "invalid_input",
        "code": "unknown_enum_value",
        "details": {
          "kind": {
            "kind": "query_identity",
            "value": "row_cardinality"
          },
          "value": {
            "kind": "query_identity",
            "value": "many"
          },
          "accepted": {
            "kind": "query_identity_list",
            "value": [
              "exactly_one",
              "bounded_many",
              "complete"
            ]
          }
        }
      }
    },
    {
      "id": "reducer.unknown",
      "description": "A reducer outside the closed vocabulary.",
      "kind": "reducer",
      "value": "variance",
      "expected": {
        "category": "invalid_input",
        "code": "unknown_enum_value",
        "details": {
          "kind": {
            "kind": "query_identity",
            "value": "reducer"
          },
          "value": {
            "kind": "query_identity",
            "value": "variance"
          },
          "accepted": {
            "kind": "query_identity_list",
            "value": [
              "count",
              "sum",
              "min",
              "max",
              "mean",
              "median",
              "std"
            ]
          }
        }
      }
    },
    {
      "id": "transaction_type.unknown",
      "description": "Transaction types are exact lowercase; bindings no longer trim or case-fold.",
      "kind": "transaction_type",
      "value": "READ",
      "expected": {
        "category": "invalid_input",
        "code": "unknown_enum_value",
        "details": {
          "kind": {
